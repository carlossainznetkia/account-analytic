<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="res_config_settings_view_form_inherit_hr_payroll_analytic_tag"
        model="ir.ui.view"
    >
        <field
            name="name"
        >res.config.settings.view.form.inherit.hr.payroll.analytic.tag</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//app[@name='hr']/block[@name='employees_setting_container']"
                position="inside"
            >
                <setting
                    id="employee_account_analytic_tag_setting"
                    help="Tag used for the payroll analytic distribution."
                >
                    <field
                        name="employee_account_analytic_tag_id"
                        class="o_light_label"
                        can_create="true"
                        can_write="true"
                    />
                </setting>
                <setting
                    id="payroll_excel_columns_setting"
                    help="Expected column headers in the payroll Excel file (columns A, B, C)."
                >
                    <field name="payroll_col_code" class="o_light_label" />
                    <field name="payroll_col_name" class="o_light_label" />
                    <field name="payroll_col_cost" class="o_light_label" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
