<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_employee_form_inherit_hr_payroll_analytic_tag" model="ir.ui.view">
        <field name="name">view.employee.form.inherit.hr.payroll.analytic.tag</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <group name="payroll_distribution">
                    <group string="Payroll Distribution">
                        <field name="payroll_code" />
                        <field name="account_analytic_tag_id" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
